{
  "name": "@mimifuwacc/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "scripts": {
    "dev": "vp run --filter @mimifuwacc/web dev",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "release": "node scripts/create-release-tag.ts",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi"
  },
  "devDependencies": {
    "cf": "1.0.0-rc.5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
