{
  "name": "@mimifuwacc/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vp run --filter @mimifuwacc/web dev",
    "format": "vp run format:fix",
    "format:check": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "lint": "vp run lint:check",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "tsx": "^4.19.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.121.0"
  }
}
