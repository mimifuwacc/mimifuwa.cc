{
	"name": "mimifuwa.cc-monorepo",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.14.0",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"fix": "turbo fix",
		"format": "biome format --write",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"test:unit": "turbo test:unit",
		"test:sb": "turbo test:sb",
		"storybook": "turbo storybook",
		"clean": "turbo clean",
		"cf:preview": "cd apps/web && pnpm cf:preview",
		"cf:deploy": "cd apps/web && pnpm cf:deploy",
		"cf:upload": "cd apps/web && pnpm cf:upload",
		"cf:typegen": "cd apps/web && pnpm cf:typegen"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/format": "^19.8.1",
		"conventional-changelog-atom": "^5.0.0",
		"turbo": "^2.5.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
