---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "mimifuwa.cc",
  description = "mimifuwacc のブログ",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/">mimifuwa.cc</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
