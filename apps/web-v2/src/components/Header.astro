---
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Home" },
  { href: "/blogs", label: "Blog" },
  { href: "/links", label: "Links" },
];
const active = (href: string) => path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="header-inner container-wide">
    <a href="/" class="brand">mimifuwa.cc</a>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {nav.map((item) => <a href={item.href} aria-current={active(item.href) ? "page" : undefined}>{item.label}</a>)}
      <button class="icon-button theme-toggle" type="button" aria-label="テーマを切り替える"><span aria-hidden="true">◐</span></button>
    </nav>
    <div class="mobile-actions">
      <button class="icon-button theme-toggle" type="button" aria-label="テーマを切り替える"><span aria-hidden="true">◐</span></button>
      <button class="icon-button menu-toggle" type="button" aria-label="メニューを開く" aria-expanded="false"><span aria-hidden="true">☰</span></button>
    </div>
  </div>
  <nav class="mobile-nav container-wide" aria-label="モバイルナビゲーション" hidden>
    {nav.map((item) => <a href={item.href} aria-current={active(item.href) ? "page" : undefined}>{item.label}</a>)}
  </nav>
</header>
