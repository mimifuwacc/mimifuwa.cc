---
import { parseToHtml } from "@mimifuwacc/parser";
import Layout from "../../layouts/Layout.astro";
import { BlogApiError, getPost } from "../../lib/blog-api";

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/");

let post;
try {
  post = await getPost(slug);
} catch (error) {
  if (error instanceof BlogApiError && error.status === 404) {
    return Astro.rewrite("/404");
  }
  throw error;
}

const { html } = await parseToHtml(post.markdown);
---

<Layout title={`${post.title} | mimifuwa.cc`} description={post.excerpt}>
  <article>
    <header class="article-header">
      <p class="eyebrow">Blog</p>
      <h1>{post.title}</h1>
      <time datetime={post.date}>{new Date(post.date).toLocaleDateString("ja-JP")}</time>
      <div class="tags">{post.tags.map((tag) => <span>#{tag}</span>)}</div>
    </header>
    <div class="prose" set:html={html} />
  </article>
</Layout>
