{
  "name": "@mimifuwacc/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f ../../env/.env -- sh -c 'ADMIN_SECRET=local-development API_URL=http://localhost:8787 CLOUDFLARE_INCLUDE_PROCESS_ENV=true vp dev --port 4000'",
    "build": "vp build && tsc --noEmit",
    "preview": "vp preview",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "pnpm cf:typegen"
  },
  "dependencies": {
    "@mimifuwacc/blog-ui": "workspace:*",
    "@mimifuwacc/parser": "workspace:*",
    "@mimifuwacc/ui": "workspace:*",
    "@tanstack/react-router": "1.170.0",
    "@tanstack/react-start": "1.168.0",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "highlight.js": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "^24",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@cloudflare/vite-plugin": "1.51.2",
    "@vitejs/plugin-react": "6.0.0",
    "vite": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
