{
  "name": "mimifuwa-cc",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
  },
  "vars": {
    "GRAPHQL_URL": "https://api.mimifuwa.cc/graphql",
  },
  "services": [
    { "binding": "API", "service": "mimifuwacc-api" },
  ],
}
