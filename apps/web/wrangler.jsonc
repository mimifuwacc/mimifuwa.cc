{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mimifuwacc",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mimifuwa.cc", "custom_domain": true }],
  "env": {
    "dev": {
      "name": "mimifuwacc-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "web-dev.mimifuwa.cc",
          "custom_domain": true,
        },
      ],
    },
  },
}
