{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mimifuwacc",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true,
  },
  "routes": [{ "pattern": "mimifuwa.cc", "custom_domain": true }],
  "services": [
    {
      "binding": "CONTENT_API",
      "service": "mimifuwacc-api",
    },
  ],
  "env": {
    "dev": {
      "name": "mimifuwacc-dev",
      "workers_dev": false,
      "preview_urls": false,
      "cache": {
        "enabled": false,
      },
      "routes": [
        {
          "pattern": "web-dev.mimifuwa.cc",
          "custom_domain": true,
        },
      ],
      "services": [
        {
          "binding": "CONTENT_API",
          "service": "mimifuwacc-api-dev",
        },
      ],
    },
  },
}
