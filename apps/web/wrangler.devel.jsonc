{
  "name": "mimifuwacc-devel",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
  },
  "vars": {
    "GRAPHQL_URL": "https://mimifuwacc-api-devel.m8c.workers.dev/graphql",
  },
  "services": [{ "binding": "API", "service": "mimifuwacc-api-devel" }],
}
