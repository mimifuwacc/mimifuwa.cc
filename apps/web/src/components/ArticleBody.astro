---
import CachedTweet from "./CachedTweet.astro";
import { splitArticleHtml } from "@mimifuwacc/blog-ui";
import { getTwitterEmbed } from "../lib/blog-api";

interface Props {
  html: string;
  requestUrl: URL;
}

const { html, requestUrl } = Astro.props;
const parts = splitArticleHtml(html);

const tweetIds = [
  ...new Set(
    parts.flatMap((part) => (part.kind === "twitter" ? [part.id] : [])),
  ),
];
const cachedTweets = new Map(
  await Promise.all(
    tweetIds.map(
      async (id) => [id, await getTwitterEmbed(requestUrl, id)] as const,
    ),
  ),
);
---

{
  parts.map((part) =>
    part.kind === "twitter" ? (
      <CachedTweet id={part.id} tweet={cachedTweets.get(part.id)} />
    ) : (
      <Fragment set:html={part.value} />
    ),
  )
}
