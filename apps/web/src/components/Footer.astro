---
import { Check, Copy, Mail } from "@lucide/astro";
import BrandIcon from "./BrandIcon.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide footer-inner">
    <div>
      <a href="/" class="footer-brand">mimifuwa.cc</a>
      <button
        type="button"
        class="session-copy"
        data-copy-uuid
        aria-label="UUID をコピー"
      >
        <span data-uuid>fa6c2a8f-27b1-4611-a0f5-19b0d6c20612</span><Copy
          class="icon copy-icon"
        /><Check class="icon check-icon" />
      </button>
    </div>
    <div class="footer-links">
      <nav aria-label="フッターナビゲーション">
        <a href="/">Home</a><a href="/blogs">Blog</a><a href="/links">Links</a>
      </nav>
      <div class="social-links">
        <a
          href="https://github.com/mimifuwacc"
          rel="me noopener"
          target="_blank"
          aria-label="GitHub"><BrandIcon name="github" /></a
        >
        <a
          href="https://twitter.com/mimifuwacc"
          rel="me noopener"
          target="_blank"
          aria-label="Twitter"><BrandIcon name="twitter" /></a
        >
        <a href="mailto:mail@mimifuwa.cc" aria-label="Email"
          ><Mail class="icon" /></a
        >
      </div>
    </div>
  </div>
  <p class="container-wide copyright">© {year} mimifuwa.cc</p>
</footer>
